[Unit]
Description=AutonoGrow monthly isolated restore-test readiness check

[Service]
Type=oneshot
User=autonogrow
Group=autonogrow
WorkingDirectory=/opt/autonogrow
EnvironmentFile=/etc/autonogrow/backend.env
ExecStart=/usr/bin/flock -n /run/lock/autonogrow-backup.lock /opt/autonogrow/.venv/bin/python /opt/autonogrow/scripts/restore_latest_postgresql_backup.py --apply --json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autonogrow /var/backups/autonogrow /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
