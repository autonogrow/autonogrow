[Unit]
Description=AutonoGrow PostgreSQL and uploads backup set
After=postgresql.service

[Service]
Type=oneshot
User=autonogrow
Group=autonogrow
WorkingDirectory=/opt/autonogrow
EnvironmentFile=/etc/autonogrow/backend.env
ExecStart=/usr/bin/flock -n /run/lock/autonogrow-backup.lock /opt/autonogrow/.venv/bin/python /opt/autonogrow/scripts/run_backup_set.py --apply
ExecStart=/usr/bin/flock -n /run/lock/autonogrow-backup.lock /opt/autonogrow/.venv/bin/python /opt/autonogrow/scripts/prune_backups.py --apply --json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/autonogrow /var/lib/autonogrow /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
