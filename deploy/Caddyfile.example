app.example.com {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    request_body {
        max_size 10MB
    }

    @internal path /internal/* /.env* /backups/*
    respond @internal 404

    @probes path /health /ready
    handle @probes {
        reverse_proxy 127.0.0.1:8000 {
            transport http {
                dial_timeout 2s
                response_header_timeout 3s
            }
        }
    }

    @backend path /api/* /uploads/businesses/*
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }

    log {
        output file /var/log/caddy/autonogrow-access.log {
            roll_size 50MiB
            roll_keep 10
            roll_keep_for 336h
        }
        format json
    }

    handle {
        root * /var/www/autonogrow
        file_server
    }
}
