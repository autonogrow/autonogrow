# Copiar a /etc/autonogrow/backend.env y sustituir todos los CHANGE_ME/example.com.
# No guardar el fichero real dentro del repositorio.
APP_ENV=production
COOKIE_SECURE=true
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
FRONTEND_ORIGINS=https://app.example.com
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
OWNER_ALLOWED_EMAILS=owner@example.com
DATABASE_URL=sqlite:////var/lib/autonogrow/data/autonogrow.db
UPLOADS_DIR=/var/lib/autonogrow/uploads
UPLOAD_MAX_SIZE_MB=5
