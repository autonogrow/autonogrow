# Copiar fuera del repo y sustituir todos los CHANGE_ME/example.com antes de staging.
APP_ENV=production
COOKIE_SECURE=true
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
SECURITY_HEADERS_ENABLED=true
FRONTEND_ORIGINS=https://staging.example.com
SESSION_SECRET=CHANGE_ME_LONG_RANDOM_STAGING_SECRET
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
OWNER_ALLOWED_EMAILS=owner@example.com
DATABASE_URL=postgresql+psycopg://autonogrow:CHANGE_ME@127.0.0.1:5432/autonogrow
ALLOW_SQLITE_IN_PRODUCTION=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=autonogrow-staging
DATABASE_MIGRATION_CHECK=true
ENABLE_LEGACY_STARTUP_MIGRATIONS=false
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_JOURNAL_MODE=WAL
SQLITE_SYNCHRONOUS=NORMAL
UPLOADS_DIR=/var/lib/autonogrow-staging/uploads
UPLOAD_MAX_SIZE_MB=5
WEBHOOK_TEST_SECRET=CHANGE_ME_RANDOM_WEBHOOK_TEST_SECRET
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
META_INTEGRATION_HEALTH_CHECK_ENABLED=true
META_INTEGRATION_HEALTH_CHECK_INTERVAL_HOURS=24
META_TOKEN_EXPIRY_WARNING_DAYS=14
META_TOKEN_EXPIRY_CRITICAL_DAYS=3
META_INTEGRATION_FAILURE_THRESHOLD=3
META_INTEGRATION_CLEANUP_INTERVAL_HOURS=24
META_EXPIRED_ATTEMPT_RETENTION_DAYS=7
META_INTEGRATION_HEALTH_BATCH_SIZE=5
META_INTEGRATION_HEALTH_JOB_TIMEOUT_SECONDS=20
META_INTEGRATION_HEALTH_LOCK_TTL_SECONDS=180
INTEGRATION_ENCRYPTION_KEYS_JSON=CHANGE_ME_JSON_KEYRING
INTEGRATION_ENCRYPTION_ACTIVE_KEY_VERSION=v1
# Deprecated: rellenar solo durante la migración inicial y eliminar después de verificarla.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_DEFAULT_BUSINESS_SLUG=
INSTAGRAM_PROVIDER_ENABLED=false
INSTAGRAM_REQUIRE_SIGNATURE=true
INSTAGRAM_LOGIN_ENABLED=false
INSTAGRAM_LOGIN_CLIENT_ID=
INSTAGRAM_LOGIN_CLIENT_SECRET=
INSTAGRAM_LOGIN_REDIRECT_URI=
INSTAGRAM_LOGIN_GRAPH_API_VERSION=v23.0
INSTAGRAM_OAUTH_ATTEMPT_TTL_SECONDS=600
INSTAGRAM_CANDIDATE_REVIEW_TTL_HOURS=72
INSTAGRAM_SIMULATED_ONBOARDING_TEST_ONLY=false
INSTAGRAM_PUBLISHING_WORKER_ENABLED=false
INSTAGRAM_PUBLISHING_POLL_SECONDS=2
INSTAGRAM_PUBLISHING_MAX_ATTEMPTS=5
INSTAGRAM_PUBLISHING_CLAIM_TTL_SECONDS=120
INSTAGRAM_PUBLISHING_BACKOFF_BASE_SECONDS=30
INSTAGRAM_PUBLISHING_BACKOFF_MAX_SECONDS=3600
INSTAGRAM_PUBLISHING_MODE=simulated
INSTAGRAM_REAL_PUBLISHING_ACKNOWLEDGED=false
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_HTTP_CONNECT_TIMEOUT_SECONDS=5
INSTAGRAM_HTTP_READ_TIMEOUT_SECONDS=20
INSTAGRAM_ASSET_URL_BASE=
INSTAGRAM_ASSET_URL_SECRET=
INSTAGRAM_ASSET_URL_TTL_SECONDS=300
INSTAGRAM_DEFAULT_TIMEZONE=Europe/Madrid
WHATSAPP_WEBHOOK_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REQUIRE_SIGNATURE=true
WHATSAPP_CUSTOMER_SERVICE_WINDOW_HOURS=24
WHATSAPP_EMBEDDED_SIGNUP_ENABLED=false
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_EMBEDDED_SIGNUP_GRAPH_API_VERSION=v26.0
WHATSAPP_EMBEDDED_SIGNUP_ATTEMPT_TTL_SECONDS=600
WHATSAPP_EMBEDDED_SIGNUP_TEST_ONLY=false
INCIDENT_ALERTS_ENABLED=false
INCIDENT_ALERT_EMAIL=
INCIDENT_ALERT_MIN_SEVERITY=high
INCIDENT_DEDUP_WINDOW_MINUTES=30
INCIDENT_RECOVERY_EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
WEBHOOK_MAX_PAYLOAD_BYTES=1048576
WORKER_ENABLED=true
WORKER_CONCURRENCY_MODE=single
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_BATCH_SIZE=10
WORKER_LOCK_TIMEOUT_SECONDS=60
WORKER_MAX_ATTEMPTS=5
WORKER_JOB_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_STALE_AFTER_SECONDS=60
PROCESS_WEBHOOK_SYNCHRONOUSLY=false
WEBHOOK_INBOX_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=90
WORKER_HEARTBEAT_RETENTION_DAYS=7
# Business onboarding adds no secrets or environment-specific settings.
+
# Operational observability and recovery (never place real tokens in Git)
APP_VERSION=0.1.0
APP_RELEASE_ID=local
APP_GIT_COMMIT=unknown
APP_BUILD_TIME=unknown
READINESS_TIMEOUT_SECONDS=2
READINESS_MIN_DISK_FREE_BYTES=268435456
LOG_LEVEL=INFO
LOG_FORMAT=auto
LOG_INCLUDE_SOURCE=false
LOG_MAX_FIELD_LENGTH=2048
LOG_REDACT_SENSITIVE=true
METRICS_ENABLED=false
METRICS_PATH=/internal/metrics
METRICS_AUTH_TOKEN=
METRICS_ALLOWED_IPS=127.0.0.1,::1
OPERATIONAL_ALERTS_ENABLED=false
ALERT_EMAIL_RECIPIENTS=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_COOLDOWN_MINUTES=30
ALERT_QUEUE_BACKLOG_WARNING=100
ALERT_QUEUE_BACKLOG_CRITICAL=500
ALERT_QUEUE_OLDEST_WARNING_SECONDS=300
ALERT_QUEUE_OLDEST_CRITICAL_SECONDS=1800
ALERT_DISK_FREE_WARNING_PERCENT=20
ALERT_DISK_FREE_CRITICAL_PERCENT=10
ALERT_BACKUP_MAX_AGE_HOURS=30
ALERT_RESTORE_TEST_MAX_AGE_DAYS=14
BACKUP_ENABLED=false
BACKUP_DIR=/var/backups/autonogrow-staging
BACKUP_STATE_DIR=/var/lib/autonogrow-staging/operations
BACKUP_RETENTION_DAYS=30
BACKUP_MINIMUM_COUNT=7
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PG_RESTORE_PATH=pg_restore
BACKUP_TIMEOUT_SECONDS=1800
MAINTENANCE_WORKER_MODE=continue
MAINTENANCE_PUBLIC_MESSAGE=Service temporarily unavailable
STORAGE_CACHE_SECONDS=60
STORAGE_SCAN_MAX_FILES=10000
