[Unit]
Description=AutonoGrow persistent channel queue worker
After=network-online.target autonogrow.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/autonogrow/backend
EnvironmentFile=/etc/autonogrow/backend.env
ExecStart=/opt/autonogrow/.venv/bin/python -m app.workers.channel_worker
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/autonogrow /var/log/autonogrow
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
