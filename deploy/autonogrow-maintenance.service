# Staging unit: keep aligned with the runtime documented in staging_deploy_checklist.md.
[Unit]
Description=AutonoGrow bounded maintenance

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/autonogrow
EnvironmentFile=/etc/autonogrow/backend.env
ExecStart=/usr/bin/flock -n /run/lock/autonogrow-maintenance.lock /opt/autonogrow/backend/.venv-next/bin/python /opt/autonogrow/scripts/run_maintenance.py --apply --json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
UMask=0077
